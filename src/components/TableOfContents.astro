---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

// 只顯示 h2、h3
const headings = Astro.props.headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnote-label');
---

{
	headings.length >= 2 && (
		<nav class="toc" aria-label="文章目錄">
			<details open>
				<summary>目錄</summary>
				<ol>
					{headings.map((h) => (
						<li class={`toc-depth-${h.depth}`}>
							<a href={`#${h.slug}`} data-toc-link={h.slug}>
								{h.text}
							</a>
						</li>
					))}
				</ol>
			</details>
		</nav>
	)
}

<script>
	// 捲動時標示目前閱讀到的章節
	const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
	if (links.length) {
		const ids = [...new Set(links.map((a) => a.dataset.tocLink!))];
		const headings = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
		const setActive = () => {
			let current = headings[0];
			for (const h of headings) {
				if (h.getBoundingClientRect().top < 120) current = h;
				else break;
			}
			links.forEach((a) => a.classList.toggle('active', a.dataset.tocLink === current?.id));
		};
		window.addEventListener('scroll', setActive, { passive: true });
		setActive();
		// 窄螢幕預設收合
		if (window.matchMedia('(max-width: 1099px)').matches) {
			document.querySelector('.toc details')?.removeAttribute('open');
		}
	}
</script>
