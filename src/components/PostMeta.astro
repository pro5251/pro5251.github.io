---
import { categoryName, categoryUrl, readingTime, type Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: Post;
	/** 是否顯示更新日期 */
	showUpdated?: boolean;
}

const { post, showUpdated = false } = Astro.props;
const { pubDate, updatedDate, category, draft, pinned } = post.data;
---

<div class="post-meta" data-pagefind-ignore>
	<FormattedDate date={pubDate} />
	{
		showUpdated && updatedDate && (
			<span>
				更新於 <FormattedDate date={updatedDate} />
			</span>
		)
	}
	<a class="meta-category" href={categoryUrl(category)}>{categoryName(category)}</a>
	<span>約 {readingTime(post.body)} 分鐘</span>
	{pinned && <span class="badge">置頂</span>}
	{draft && <span class="badge badge-draft">草稿</span>}
</div>
