---
import { NAV_LINKS, SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' || /^\/\d+\/$/.test(path) || path.startsWith('/posts/') : path.startsWith(href);
---

<header class="site-header">
	<div class="container header-inner">
		<a class="site-title" href="/">{SITE.title}</a>
		<nav aria-label="主選單">
			<ul class="nav-list">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a href={link.href} class:list={{ active: isActive(link.href) }} aria-current={isActive(link.href) ? 'page' : undefined}>
								{link.label}
							</a>
						</li>
					))
				}
				<li>
					<a href="/search/" class:list={['search-link', { active: path.startsWith('/search/') }]} aria-label="搜尋" title="搜尋（按 / 鍵）">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
							<circle cx="11" cy="11" r="7"></circle>
							<path d="m20 20-3.5-3.5"></path>
						</svg>
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<script>
	// 按下「/」快速前往搜尋頁（輸入框中不觸發）
	document.addEventListener('keydown', (e) => {
		if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
		const el = e.target as HTMLElement;
		if (el.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName)) return;
		if (location.pathname.startsWith('/search/')) return;
		e.preventDefault();
		location.href = '/search/';
	});
</script>
