---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTagCounts, tagSlug, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return getTagCounts(posts).map((t) => ({
		params: { tag: t.slug },
		props: { name: t.name, posts: posts.filter((p) => p.data.tags.some((x) => tagSlug(x) === t.slug)) },
	}));
}

interface Props {
	name: string;
	posts: Post[];
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`#${name}`} description={`標籤「${name}」的所有文章。`}>
	<p class="breadcrumb"><a href="/tags/">標籤</a> /</p>
	<h1 class="page-title">#{name}<span class="count">{posts.length} 篇</span></h1>
	<PostList posts={posts} />
</BaseLayout>
