---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import PostMeta from '../../components/PostMeta.astro';
import PostNav from '../../components/PostNav.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import SeriesBox from '../../components/SeriesBox.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import TagList from '../../components/TagList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryName, getPosts, getRelatedPosts, getSeriesPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			newer: posts[i - 1],
			older: posts[i + 1],
			related: getRelatedPosts(post, posts),
			seriesPosts: post.data.series ? getSeriesPosts(post.data.series, posts) : [],
		},
	}));
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
	related: Post[];
	seriesPosts: Post[];
}

const { post, newer, older, related, seriesPosts } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, category, tags, heroImage, heroImageAlt, series, toc, comments, draft } =
	post.data;
const showToc = toc && headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnote-label').length >= 2;
const hasMermaid = post.body?.includes('```mermaid') ?? false;
---

<BaseLayout
	title={title}
	description={description}
	image={heroImage}
	article={{ pubDate, updatedDate, category: categoryName(category), tags }}
	noindex={draft}
	wide={showToc}
>
	{hasMermaid && <link slot="head" rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />}
	<div class="reading-progress" aria-hidden="true"></div>
	<div class:list={['post-layout', { 'has-toc': showToc }]}>
		<div class="post-main">
			<article class="post" data-pagefind-body>
				<header class="post-header">
					<h1 class="post-title">{title}</h1>
					<PostMeta post={post} showUpdated />
					<span hidden data-pagefind-filter="分類">{categoryName(category)}</span>
					<span hidden data-pagefind-meta="日期">{pubDate.toISOString().slice(0, 10)}</span>
				</header>

				{
					heroImage && (
						<figure class="hero-image">
							<Image src={heroImage} width={1200} alt={heroImageAlt} loading="eager" fetchpriority="high" />
						</figure>
					)
				}

				{series && <SeriesBox series={series} posts={seriesPosts} currentId={post.id} />}

				{showToc && <div class="toc-inline"><TableOfContents headings={headings} /></div>}

				<div class="prose">
					<Content />
				</div>

				<footer class="post-footer">
					<TagList tags={tags} />
					<ShareLinks title={title} />
				</footer>
			</article>

			<div class="post-after" data-pagefind-ignore>
				<PostNav newer={newer} older={older} />
				<RelatedPosts posts={related} />
				{comments && <Comments />}
			</div>
		</div>

		{
			showToc && (
				<aside class="toc-aside" data-pagefind-ignore>
					<TableOfContents headings={headings} />
				</aside>
			)
		}
	</div>

	<dialog class="lightbox" aria-label="放大圖片">
		<img alt="" />
	</dialog>
</BaseLayout>

<script>
	// 1. 標題錨點：滑過標題出現 # ，點擊可複製該段落連結
	document.querySelectorAll<HTMLElement>('.prose :is(h2, h3, h4)[id]').forEach((h) => {
		const a = document.createElement('a');
		a.className = 'heading-anchor';
		a.href = `#${h.id}`;
		a.setAttribute('aria-label', '此段落的連結');
		a.textContent = '#';
		h.appendChild(a);
	});

	// 2. 程式碼區塊複製按鈕
	document.querySelectorAll<HTMLPreElement>('.prose pre:not([data-language="mermaid"])').forEach((pre) => {
		const wrapper = document.createElement('div');
		wrapper.className = 'code-block';
		pre.parentNode!.insertBefore(wrapper, pre);
		wrapper.appendChild(pre);

		const lang = pre.dataset.language;
		if (lang && lang !== 'plaintext') {
			const label = document.createElement('span');
			label.className = 'code-lang';
			label.textContent = lang;
			wrapper.appendChild(label);
		}

		const btn = document.createElement('button');
		btn.type = 'button';
		btn.className = 'copy-btn';
		btn.textContent = '複製';
		btn.addEventListener('click', async () => {
			const code = pre.querySelector('code')?.innerText ?? pre.innerText;
			try {
				await navigator.clipboard.writeText(code);
				btn.textContent = '已複製';
			} catch {
				btn.textContent = '複製失敗';
			}
			setTimeout(() => (btn.textContent = '複製'), 1500);
		});
		wrapper.appendChild(btn);
	});

	// 3. 閱讀進度條
	const bar = document.querySelector<HTMLElement>('.reading-progress');
	const article = document.querySelector<HTMLElement>('.post');
	if (bar && article) {
		const update = () => {
			const rect = article.getBoundingClientRect();
			const total = rect.height - window.innerHeight;
			const ratio = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
			bar.style.transform = `scaleX(${ratio})`;
		};
		window.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
		update();
	}

	// 4. 圖片點擊放大
	const lightbox = document.querySelector<HTMLDialogElement>('.lightbox');
	const lightboxImg = lightbox?.querySelector('img');
	if (lightbox && lightboxImg) {
		document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
			if (img.closest('a')) return; // 已經是連結的圖片不處理
			img.classList.add('zoomable');
			img.tabIndex = 0;
			const open = () => {
				lightboxImg.src = img.currentSrc || img.src;
				lightboxImg.alt = img.alt;
				lightbox.showModal();
			};
			img.addEventListener('click', open);
			img.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					open();
				}
			});
		});
		lightbox.addEventListener('click', () => lightbox.close());
	}

	// 5. Mermaid 圖表：只有文章中有 ```mermaid 時才從 CDN 載入
	const mermaidBlocks = document.querySelectorAll<HTMLPreElement>('.prose pre[data-language="mermaid"]');
	if (mermaidBlocks.length) {
		const MERMAID_URL = 'https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.esm.min.mjs';
		mermaidBlocks.forEach((pre) => {
			const div = document.createElement('div');
			div.className = 'mermaid';
			div.textContent = pre.querySelector('code')?.innerText ?? pre.innerText;
			pre.replaceWith(div);
		});
		import(/* @vite-ignore */ MERMAID_URL)
			.then(({ default: mermaid }) => {
				mermaid.initialize({ startOnLoad: false, theme: 'neutral', securityLevel: 'strict' });
				return mermaid.run({ querySelector: '.prose .mermaid' });
			})
			.catch((err) => console.error('Mermaid 載入失敗', err));
	}
</script>
